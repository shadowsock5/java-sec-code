<configuration>
  <configSections>
    <section name="nlog" type="NLog.Config.ConfigSectionHandler, NLog" />
    <section name="autofac" type="Autofac.Configuration.SectionHandler, Autofac.Configuration" />
  </configSections>
  <autofac configSource="Config\AutoFac.config"></autofac>
  <nlog configSource="Config\NLog.config"></nlog>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Autofac" publicKeyToken="17863af14b0044da" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-3.5.0.0" newVersion="3.5.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
  <system.web>
    <compilation targetFramework="4.5" />
    <httpRuntime targetFramework="4.5" requestValidationMode="2.0" maxRequestLength="10240" />
    <pages validateRequest="true" enableEventValidation="false" controlRenderingCompatibilityVersion="3.5" clientIDMode="AutoID">
      <controls>
        <add tagPrefix="anthem" namespace="Anthem" assembly="Anthem" />
        <add tagPrefix="easy" namespace="Prolliance.Common.UI" assembly="Prolliance.Common.UI" />
        <add tagPrefix="easy" namespace="Prolliance.Common.UI.WebControls" assembly="Prolliance.Common.UI" />
        <add tagPrefix="easy" tagName="EasyView" src="~/controls/easyview.ascx" />
        <add tagPrefix="easy" tagName="EasySearch" src="~/controls/easysearch.ascx" />
        <add tagPrefix="easy" tagName="EasyBrowse" src="~/controls/easybrowse.ascx" />
        <add tagPrefix="easy" tagName="ExecSql" src="~/controls/EasySql.ascx" />
      </controls>
    </pages>
    <sessionState mode="StateServer" stateConnectionString="tcpip=127.0.0.1:42424" cookieless="false" timeout="120">
      <providers>
        <add name="DefaultSessionProvider" type="System.Web.Providers.DefaultSessionStateProvider, System.Web.Providers, Version=1.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" connectionStringName="DefaultConnection" />
      </providers>
    </sessionState>
  </system.web>
  <connectionStrings>
